
#include <iostream>
#include <cmath>
#include <algorithm>
using namespace std;
int main()
{
int n; cin>>n; 
int arr[n]; 
for(int i=0; i<n; i++)
cin >>arr[i]; 
long long c;
cin>>c; 
sort(arr,arr+n); 
long long ans=0;
int ind=0;
for(int i=0; i<n; i++){
    if(ans+arr[i]<=c){
 ans+=arr[i];
 ind++;}
 else
 break; 
    
}
cout<<ind<<" "<<c-ans<<endl; 
    return 0;
}
